<Window x:Class="FalconCanBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FalconCanBridge.App.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:FalconCanBridge.Core.Models;assembly=FalconCanBridge.Core"
        Title="Falcon CAN Bridge - BMS/DCS to STM32 CAN panels"
        Height="760" Width="1180" MinHeight="600" MinWidth="900">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />

        <ObjectDataProvider x:Key="DirectionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MappingDirection" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="TargetValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SimulatorTarget" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CanDataType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ================= Connections ================= -->
            <TabItem Header="Connections">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Flight Simulator" Grid.Column="0" Margin="0,0,8,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Source" FontWeight="Bold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SimulatorChoices}" SelectedItem="{Binding SelectedSimulator}" Width="220" HorizontalAlignment="Left" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="12" Height="12" Fill="{Binding IsSimulatorConnected, Converter={StaticResource BoolToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SimulatorStatus}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Connect" Width="100" Margin="0,0,8,0" Command="{Binding ConnectSimulatorCommand}" />
                                <Button Content="Disconnect" Width="100" Command="{Binding DisconnectSimulatorCommand}" />
                            </StackPanel>

                            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="Gray">
                                Falcon 4 BMS: reads the "FalconSharedMemoryArea" shared memory block while BMS is running a mission - no extra setup needed on the BMS side.
                                <LineBreak /><LineBreak />
                                DCS World: requires DCS-BIOS's Export.lua hook to be installed in your Saved Games\DCS\Scripts folder (see README/docs/DCS_SETUP.md). Listens on UDP 239.255.50.10:5010 and sends commands to 127.0.0.1:7778 by default.
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="CAN Bus Adapter (STM32 panel bus)" Grid.Column="1" Margin="8,0,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Adapter type" FontWeight="Bold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CanAdapterChoices}" SelectedItem="{Binding SelectedCanAdapter}" Width="220" HorizontalAlignment="Left" />

                            <TextBlock Text="SLCAN (STM32 USB-CDC) settings" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial port:" VerticalAlignment="Center" Margin="0,2,8,2" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="CAN bitrate (bps):" VerticalAlignment="Center" Margin="0,2,8,2" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CanBitrate, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial baud:" VerticalAlignment="Center" Margin="0,2,8,2" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SerialBaud, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,2" />
                            </Grid>

                            <TextBlock Text="PCAN-Basic settings" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel (USB1..USB4):" VerticalAlignment="Center" Margin="0,2,8,2" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PcanChannel, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,2" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Ellipse Width="12" Height="12" Fill="{Binding IsCanOpen, Converter={StaticResource BoolToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CanStatus}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Open" Width="100" Margin="0,0,8,0" Command="{Binding ConnectCanCommand}" />
                                <Button Content="Close" Width="100" Command="{Binding DisconnectCanCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= Live Telemetry ================= -->
            <TabItem Header="Live Telemetry">
                <DataGrid ItemsSource="{Binding Telemetry}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="260" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:0.###}}" Width="140" />
                        <DataGridTextColumn Header="Text" Binding="{Binding TextValue}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ================= CAN Mapping ================= -->
            <TabItem Header="CAN Mapping">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MappingProfileName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0" />
                        <Button Content="Load..." Width="90" Margin="0,0,6,0" Command="{Binding LoadMappingCommand}" />
                        <Button Content="Save As..." Width="90" Margin="0,0,20,0" Command="{Binding SaveMappingCommand}" />
                        <Button Content="Add Row" Width="90" Margin="0,0,6,0" Command="{Binding AddMappingCommand}" />
                        <Button Content="Remove Selected" Width="120" Command="{Binding RemoveMappingCommand}" CommandParameter="{Binding ElementName=MappingGrid, Path=SelectedItem}" />
                    </StackPanel>

                    <DataGrid x:Name="MappingGrid" ItemsSource="{Binding Mappings}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridComboBoxColumn Header="Direction" SelectedItemBinding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Source={StaticResource DirectionValues}}" Width="100" />
                            <DataGridComboBoxColumn Header="Target" SelectedItemBinding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Source={StaticResource TargetValues}}" Width="100" />
                            <DataGridTextColumn Header="Signal Name" Binding="{Binding SignalName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="Command Name" Binding="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="CAN ID" Binding="{Binding CanIdHex, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridCheckBoxColumn Header="Ext" Binding="{Binding ExtendedId, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Byte" Binding="{Binding ByteOffset, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Bit" Binding="{Binding BitOffset, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Source={StaticResource DataTypeValues}}" Width="90" />
                            <DataGridCheckBoxColumn Header="LE" Binding="{Binding LittleEndian, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Scale" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Min" Binding="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Rate ms" Binding="{Binding SendRateMs, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Threshold" Binding="{Binding ChangeThreshold, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= CAN Traffic ================= -->
            <TabItem Header="CAN Traffic">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Top" Content="Clear" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding ClearCanTrafficCommand}" />
                    <DataGrid ItemsSource="{Binding CanTraffic}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="110" />
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="60" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="90" />
                            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50" />
                            <DataGridTextColumn Header="Data" Binding="{Binding DataHex}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= Log ================= -->
            <TabItem Header="Log">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Top" Content="Clear" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding ClearLogCommand}" />
                    <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
